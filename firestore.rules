rules_version = '2';

// Production rules for Prickles & Goo.
// Reads are public. The ONLY writes the public can make are:
//   1. A single valid vote (item update bumping shown + exactly one of
//      gooey/prickly/skipped by 1, nothing else).
//   2. A commentary reason (create {text,votes==1,createdAt==now} or +1 a vote).
// Everything else — creating/renaming items, publishing ballots — is denied to
// the public. Those admin jobs run through the service-account CLI (admin/),
// which has full privileges and bypasses these rules entirely. No in-app auth,
// no admin allowlist, no rule-swapping.

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidReason() {
      let r = request.resource.data;
      return r.keys().hasOnly(['text', 'votes', 'createdAt'])
        && r.text is string && r.text.size() >= 1 && r.text.size() <= 140
        && r.votes == 1
        && r.createdAt == request.time;
    }

    function isReasonUpvote() {
      let r = request.resource.data;
      let o = resource.data;
      return r.diff(o).affectedKeys().hasOnly(['votes']) && r.votes == o.get('votes', 0) + 1;
    }

    function isSingleVote() {
      let r = request.resource.data;
      let o = resource.data;
      let changed = r.diff(o).affectedKeys();
      let dG  = r.get('gooey', 0)   - o.get('gooey', 0);
      let dP  = r.get('prickly', 0) - o.get('prickly', 0);
      let dSk = r.get('skipped', 0) - o.get('skipped', 0);
      let dSum = r.get('iSum', 0)   - o.get('iSum', 0);
      let dCnt = r.get('iVotes', 0) - o.get('iVotes', 0);
      let dSq  = r.get('iSumSq', 0) - o.get('iSumSq', 0);
      return changed.hasOnly(['shown', 'gooey', 'prickly', 'skipped', 'iSum', 'iVotes', 'iSumSq'])
        && r.get('shown', 0) == o.get('shown', 0) + 1
        && ( (dG == 1 && dP == 0 && dSk == 0) ||
             (dP == 1 && dG == 0 && dSk == 0) ||
             (dSk == 1 && dG == 0 && dP == 0) )
        && ( (dCnt == 0 && dSum == 0 && dSq == 0) ||
             (dCnt == 1 && dSq == dSum * dSum &&
                ( (dG == 1 && dSum > 0 && dSum <= 100) ||
                  (dP == 1 && dSum < 0 && dSum >= -100) )) );
    }

    match /categories/{category} {
      allow read: if true;
      allow write: if false;                 // category docs: CLI only

      match /items/{item} {
        allow read: if true;
        allow create, delete: if false;       // seeding is CLI only
        allow update: if isSingleVote();       // public can only cast a vote

        match /reasons_gooey/{reason} {
          allow read: if true;
          allow create: if isValidReason();
          allow update: if isReasonUpvote();
          allow delete: if false;
        }
        match /reasons_prickly/{reason} {
          allow read: if true;
          allow create: if isValidReason();
          allow update: if isReasonUpvote();
          allow delete: if false;
        }
      }
    }

    // Curated daily ballots: public reads (the app loads today's); only the CLI writes.
    match /ballots/{date} {
      allow read: if true;
      allow write: if false;
    }
  }
}
