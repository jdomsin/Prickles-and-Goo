rules_version = '2';

// Production rules for Prickles & Goo.
// Reads are public. Writes are split into two tiers:
//
//  PUBLIC (anonymous) — exactly two shapes:
//   1. A single valid vote: an item update that bumps `shown` by 1 and exactly
//      one of gooey/prickly/skipped by 1, leaving everything else (incl. `name`)
//      untouched.
//   2. A commentary reason: create {text (1–140), votes==1, createdAt==now} in
//      items/{id}/reasons_gooey|prickly, or agree by bumping only `votes` by 1.
//
//  ADMIN (you, signed in with Google as the address in isAdmin()) — everything else:
//   • create/rename items + category docs  → this is SEEDING. No more rule-swap:
//     sign in on /seed.html and run it.
//   • write today's curated ballot          → /desk.html "Morning Desk".
//
// Everything else — anonymous item creation, value tampering, decrements,
// deletes — is denied.
//
// LIMITATION: without App Check these rules can't rate-limit an anonymous user
// repeatedly casting +1 votes. They close the data-corruption hole, not
// ballot-stuffing. Add App Check for that next level.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── the admin gate ──
    // Only this Google account can seed items or publish ballots. To change it,
    // edit the address here AND re-publish these rules in the Firebase Console.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'jdomins1@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isValidReason() {
      let r = request.resource.data;
      return r.keys().hasOnly(['text', 'votes', 'createdAt'])
        && r.text is string && r.text.size() >= 1 && r.text.size() <= 140
        && r.votes == 1
        && r.createdAt == request.time;
    }

    function isReasonUpvote() {
      let r = request.resource.data;
      let o = resource.data;
      return r.diff(o).affectedKeys().hasOnly(['votes']) && r.votes == o.get('votes', 0) + 1;
    }

    function isSingleVote() {
      let r = request.resource.data;
      let o = resource.data;
      let changed = r.diff(o).affectedKeys();
      // Use .get() on BOTH sides so a freshly-seeded item (only {name}, no vote
      // fields yet) isn't rejected on its first vote when fields are absent.
      let dG  = r.get('gooey', 0)   - o.get('gooey', 0);
      let dP  = r.get('prickly', 0) - o.get('prickly', 0);
      let dSk = r.get('skipped', 0) - o.get('skipped', 0);
      let dSum = r.get('iSum', 0)   - o.get('iSum', 0);
      let dCnt = r.get('iVotes', 0) - o.get('iVotes', 0);
      let dSq  = r.get('iSumSq', 0) - o.get('iSumSq', 0);
      return changed.hasOnly(['shown', 'gooey', 'prickly', 'skipped', 'iSum', 'iVotes', 'iSumSq'])
        && r.get('shown', 0) == o.get('shown', 0) + 1
        // exactly one of gooey/prickly/skipped bumped by 1, the others untouched
        && ( (dG == 1 && dP == 0 && dSk == 0) ||
             (dP == 1 && dG == 0 && dSk == 0) ||
             (dSk == 1 && dG == 0 && dP == 0) )
        // intensity: either none (legacy / skip) OR one bounded, sign-consistent vote.
        && ( (dCnt == 0 && dSum == 0 && dSq == 0) ||
             (dCnt == 1 && dSq == dSum * dSum &&
                ( (dG == 1 && dSum > 0 && dSum <= 100) ||
                  (dP == 1 && dSum < 0 && dSum >= -100) )) );
    }

    match /categories/{category} {
      allow read: if true;
      allow write: if isAdmin();              // category docs — managed by the admin (seeding)

      match /items/{item} {
        allow read: if true;
        allow create, delete: if isAdmin();   // seeding adds items; nobody else creates/deletes
        allow update: if isSingleVote() || isAdmin();   // public votes, or admin renames/re-seeds

        // Commentary: written reasons + agree (upvote). One match per verdict pool.
        match /reasons_gooey/{reason} {
          allow read: if true;
          allow create: if isValidReason();
          allow update: if isReasonUpvote();
          allow delete: if false;
        }
        match /reasons_prickly/{reason} {
          allow read: if true;
          allow create: if isValidReason();
          allow update: if isReasonUpvote();
          allow delete: if false;
        }
      }
    }

    // Curated daily ballots, published from the Morning Desk. Public reads (the
    // app loads today's), admin-only writes.
    match /ballots/{date} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
