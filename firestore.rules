rules_version = '2';

// Production rules for Prickles & Goo.
// Reads are public. Allowed writes are tightly shaped:
//  1. A single valid vote: an item update that bumps `shown` by 1 and exactly
//     one of gooey/prickly/skipped by 1, leaving everything else (incl. `name`)
//     untouched.
//  2. A commentary reason: create a doc in items/{id}/reasons_gooey|prickly with
//     exactly {text (1–140 chars), votes==1, createdAt==now}; or agree with an
//     existing reason by bumping only its `votes` by 1.
// Everything else — arbitrary writes, value tampering, decrements, item/category
// creation or deletion — is denied.
//
// SEEDING NOTE: seed.html writes item/category `name` (and `wiki`) fields, which
// these rules DENY. To add items: publish firestore.seeding.rules, run seed.html,
// then re-publish THIS file. Existing items must already exist for votes to work —
// votes are updates, not creates.
//
// LIMITATION: without authentication / Firebase App Check, these rules cannot
// rate-limit an anonymous user repeatedly casting +1 votes. They close the
// data-corruption hole, not ballot-stuffing. Add App Check for that next level.

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidReason() {
      let r = request.resource.data;
      return r.keys().hasOnly(['text', 'votes', 'createdAt'])
        && r.text is string && r.text.size() >= 1 && r.text.size() <= 140
        && r.votes == 1
        && r.createdAt == request.time;
    }

    function isReasonUpvote() {
      let r = request.resource.data;
      let o = resource.data;
      return r.diff(o).affectedKeys().hasOnly(['votes']) && r.votes == o.get('votes', 0) + 1;
    }

    function isSingleVote() {
      let r = request.resource.data;
      let o = resource.data;
      let changed = r.diff(o).affectedKeys();
      // Use .get() on BOTH sides so a freshly-seeded item (only {name}, no vote
      // fields yet) isn't rejected on its first vote when prickly/skipped are absent.
      return changed.hasOnly(['shown', 'gooey', 'prickly', 'skipped'])
        && r.get('shown', 0) == o.get('shown', 0) + 1
        && (
             (r.get('gooey', 0)   == o.get('gooey', 0) + 1   && r.get('prickly', 0) == o.get('prickly', 0) && r.get('skipped', 0) == o.get('skipped', 0)) ||
             (r.get('prickly', 0) == o.get('prickly', 0) + 1 && r.get('gooey', 0)   == o.get('gooey', 0)   && r.get('skipped', 0) == o.get('skipped', 0)) ||
             (r.get('skipped', 0) == o.get('skipped', 0) + 1 && r.get('gooey', 0)   == o.get('gooey', 0)   && r.get('prickly', 0) == o.get('prickly', 0))
           );
    }

    match /categories/{category} {
      allow read: if true;
      allow write: if false;                 // category docs are managed via seeding only

      match /items/{item} {
        allow read: if true;
        allow create, delete: if false;
        allow update: if isSingleVote();

        // Commentary: written reasons + agree (upvote). One match per verdict pool.
        match /reasons_gooey/{reason} {
          allow read: if true;
          allow create: if isValidReason();
          allow update: if isReasonUpvote();
          allow delete: if false;
        }
        match /reasons_prickly/{reason} {
          allow read: if true;
          allow create: if isValidReason();
          allow update: if isReasonUpvote();
          allow delete: if false;
        }
      }
    }
  }
}
